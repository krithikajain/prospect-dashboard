# ==========================================
# Prospect Dashboard Backend - Local Environment
# ==========================================
# Copy this file to '.env' and fill in your actual API keys.
# Do NOT commit your real '.env' file to source control.

# --- Core LLM Provider ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- ContactOut Enrichment Integration ---
# Used for enriching email addresses to full prospect data profiles
CONTACTOUT_API_KEY=your_contactout_api_key_here

# --- Email Deliverability Verification (Optional) ---
# Used for verifying whether an email will bounce before spending ContactOut credits
QUICKEMAILVERIFICATION_API_KEY=your_qev_api_key_here

# --- Cache Configuration (Optional) ---
# Valid options: SQLITE (default local), GCP_DATASTORE (production)
CACHE_MODE=SQLITE
